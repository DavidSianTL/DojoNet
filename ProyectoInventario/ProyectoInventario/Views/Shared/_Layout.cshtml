<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Inventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoInventario.styles.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed">
    <!-- Fondo oscuro para móviles -->
    <div class="sb-sidenav-backdrop" id="sidenavBackdrop"></div>
    
    <div id="layoutSidenav" class="d-flex">
        <!-- Sidebar -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Principal</div>
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="bi bi-speedometer2"></i></div>
                            Panel de Control
                        </a>
                        
                        <div class="sb-sidenav-menu-heading">Inventario</div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseInventario" aria-expanded="false" aria-controls="collapseInventario">
                            <div class="sb-nav-link-icon"><i class="bi bi-pc-display"></i></div>
                            Dispositivos
                            <div class="sb-sidenav-collapse-arrow"><i class="bi bi-chevron-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseInventario" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="#"><i class="bi bi-grid-3x3-gap me-2"></i> Todos los Dispositivos</a>
                                <a class="nav-link" href="#"><i class="bi bi-check-circle me-2"></i> Disponibles</a>
                                <a class="nav-link" href="#"><i class="bi bi-person-check me-2"></i> Asignados</a>
                                <a class="nav-link" href="#"><i class="bi bi-tools me-2"></i> En Mantenimiento</a>
                                <a class="nav-link" href="#"><i class="bi bi-dash-circle me-2"></i> Dados de Baja</a>
                            </nav>
                        </div>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Conectado como:</div>
                    Usuario Administrador
                </div>
            </nav>
        </div>

        <!-- Contenido principal -->
        <div id="layoutSidenav_content">
            <!-- Navbar Superior -->
            <nav class="sb-topnav navbar navbar-expand navbar-dark bg-primary">
                <!-- Sidebar Toggle -->
                <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
        
        <!-- Navbar Brand -->
        <a class="navbar-brand ps-0 ps-lg-3" asp-controller="Home" asp-action="Index">
            <i class="bi bi-pc-display-horizontal me-2"></i>
            <span class="d-none d-md-inline">Sistema de Inventario</span>
            <span class="d-inline d-md-none">SI</span>
        </a>
        
        <!-- Navbar Search -->
        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Buscar..." aria-label="Buscar" aria-describedby="btnNavbarSearch" />
                <button class="btn btn-primary" id="btnNavbarSearch" type="button">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
        
        <!-- Navbar -->
        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-fill"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <li><a class="dropdown-item" href="#!">Mi Perfil</a></li>
                    <li><a class="dropdown-item" href="#!">Configuración</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="#!">Cerrar Sesión</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav" class="d-flex">
        <!-- Sidebar -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu-header p-3 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="position-relative">
                            <div class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle">
                                <span class="visually-hidden">Notificaciones</span>
                            </div>
                            <i class="bi bi-shield-lock fs-3 text-white"></i>
                        </div>
                        <div class="ms-3 d-none d-lg-block">
                            <div class="fw-bold text-white">Admin</div>
                            <div class="small text-white-50">Administrador</div>
                        </div>
                    </div>
                </div>
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Principal</div>
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="bi bi-speedometer2"></i></div>
                            Panel de Control
                        </a>
                        
                        <div class="sb-sidenav-menu-heading">Inventario</div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseInventario" aria-expanded="false" aria-controls="collapseInventario">
                            <div class="sb-nav-link-icon"><i class="bi bi-pc-display"></i></div>
                            Dispositivos
                            <div class="sb-sidenav-collapse-arrow"><i class="bi bi-chevron-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseInventario" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="#"><i class="bi bi-grid-3x3-gap"></i> Todos los Dispositivos</a>
                                <a class="nav-link" href="#"><i class="bi bi-check-circle"></i> Disponibles</a>
                                <a class="nav-link" href="#"><i class="bi bi-person-check"></i> Asignados</a>
                                <a class="nav-link" href="#"><i class="bi bi-tools"></i> En Mantenimiento</a>
                                <a class="nav-link" href="#"><i class="bi bi-dash-circle"></i> Dados de Baja</a>
                            </nav>
                        </div>
                        
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseEmpleados" aria-expanded="false" aria-controls="collapseEmpleados">
                            <div class="sb-nav-link-icon"><i class="bi bi-people"></i></div>
                            Empleados
                            <div class="sb-sidenav-collapse-arrow"><i class="bi bi-chevron-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseEmpleados" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="#">Lista de Empleados</a>
                                <a class="nav-link" href="#">Asignación de Equipos</a>
                                <a class="nav-link" href="#">Historial de Asignaciones</a>
                            </nav>
                        </div>
                        
                        <div class="sb-sidenav-menu-heading">Configuración</div>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="bi bi-tags"></i></div>
                            Categorías
                        </a>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="bi bi-tools"></i></div>
                            Mantenimientos
                        </a>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="bi bi-building-gear"></i></div>
                            Departamentos
                        </a>
                        
                        <div class="sb-sidenav-menu-heading">Reportes</div>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="bi bi-graph-up"></i></div>
                            Inventario Actual
                        </a>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="bi bi-file-earmark-text"></i></div>
                            Historial de Movimientos
                        </a>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Conectado como:</div>
                    Usuario Administrador
                </div>
            </nav>
            <!-- Footer de la barra lateral -->
            <div class="sb-sidenav-footer text-center py-3 d-none d-lg-block">
                <div class="small">v1.0.0</div>
                <div class="text-muted">© @DateTime.Now.Year</div>
            </div>
        </div>

        <!-- Contenido Principal -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <h1 class="mt-4">@ViewData["Title"]</h1>
                    <ol class="breadcrumb mb-4">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                    
                    @RenderBody()
                </div>
            </main>
            
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; Sistema de Inventario @DateTime.Now.Year</div>
                        <div>
                            <a href="#">Política de Privacidad</a>
                            &middot;
                            <a href="#">Términos &amp; Condiciones</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Script para el menú desplegable en móviles -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidenavAccordion');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidenavBackdrop = document.getElementById('sidenavBackdrop');
            
            // Alternar menú en móviles
            function toggleSidebar() {
                sidebar.closest('#layoutSidenav_nav').classList.toggle('show');
                sidenavBackdrop.classList.toggle('show');
                document.body.classList.toggle('sb-sidenav-toggled');
            }
            
            // Cerrar menú al hacer clic en el fondo oscuro
            sidenavBackdrop.addEventListener('click', function() {
                toggleSidebar();
            });
            
            // Alternar menú al hacer clic en el botón
            sidebarToggle.addEventListener('click', function(e) {
                e.preventDefault();
                if (window.innerWidth < 768) {
                    toggleSidebar();
                } else {
                    document.body.classList.toggle('sb-sidenav-toggled');
                }
            });
            
            // Cerrar menú al hacer clic en un enlace en móviles
            document.querySelectorAll('.sb-sidenav .nav-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 768) {
                        toggleSidebar();
        });
    </script>
    <script>
        // Activar tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Toggle del menú lateral
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.body.querySelector('#sidebarToggle');
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', event => {
                    event.preventDefault();
                    document.body.classList.toggle('sb-sidenav-toggled');
                    localStorage.setItem('sb|sidebar-toggle', document.body.classList.contains('sb-sidenav-toggled'));
                });
            }
            
            // Restaurar estado del menú lateral
            if (localStorage.getItem('sb|sidebar-toggle') === 'true') {
                document.body.classList.add('sb-sidenav-toggled');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
